PANBOX_DB_PASSWORD=replace-with-long-random-value
PANBOX_BOOTSTRAP_EMAIL=admin@example.com
PANBOX_BOOTSTRAP_PASSWORD=replace-with-unique-16-char-password
# false only for loopback HTTP local testing. Use true behind HTTPS.
PANBOX_SECURE_COOKIE=false
# Change these if local ports are occupied.
PANBOX_HOST_PORT=8080
PANBOX_DB_HOST_PORT=5434
