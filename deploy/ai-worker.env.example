# Copy to /etc/panbox/ai-worker.env on the PANBOX host; do not commit the real file.
# URL-encode special characters in the database password.
DATABASE_URL=postgres://panbox:<url-encoded-db-password>@127.0.0.1:5434/panbox?sslmode=disable
# Must match PANBOX_SCM_ENCRYPTION_KEY in the dashboard's private .env exactly.
PANBOX_SCM_ENCRYPTION_KEY=<same-64-hex-character-key>
# Absolute path to the PANBOX checkout used by the dashboard.
PANBOX_MIGRATIONS_DIR=/opt/panbox/migrations
