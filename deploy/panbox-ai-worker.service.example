[Unit]
Description=PANBOX optional Codex AI review worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=panbox-ai
Group=panbox-ai
WorkingDirectory=/opt/panbox
EnvironmentFile=/etc/panbox/ai-worker.env
Environment=HOME=/var/lib/panbox-ai
Environment=CODEX_HOME=/var/lib/panbox-ai/.codex
Environment=PATH=/var/lib/panbox-ai/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/panbox/panbox-ai-worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
